  "calcs": [
    {
      "name": "motor_power",
      "formula": "${mono}.torque * ${mono}.speed * 2 * pi / 60 / 1000",
      "unit": "kW",
      "decimals": 2,
      "type": "number",
      "description": "Mechanical shaft power P = T·ω with ω = rpm · 2π/60. Negative while braking."
    },
    {
      "name": "velocity",
      "formula": "${mono}.speed / 1450 * 1.2",
      "unit": "m/s",
      "decimals": 2,
      "type": "number",
      "description": "Travel speed. The simulator moves 1.2 m/s at 1450 rpm; replace 1.2 with the real gear and wheel factor."
    },
    {
      "name": "time_to_obstacle",
      "formula": "if(${mono}.motor_dir == 1 && calc.velocity > 0.01, ${mono}.distance / calc.velocity, 0)",
      "unit": "s",
      "decimals": 1,
      "type": "number",
      "description": "Seconds until the obstacle at the current speed, 0 when not driving forward. Uses calc.velocity."
    },
    {
      "name": "drive_ready",
      "formula": "${mono}.power && !${mono}.fu_off && !${mono}.fault",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "Power on, frequency converter connected and no fault."
    },
    {
      "name": "kv_speed_rpm",
      "formula": "${kv}.speedAct / 16384 * 3000",
      "unit": "rpm",
      "decimals": 0,
      "type": "number",
      "description": "speedAct scaled: 16#4000 = p2000 (reference speed). 3000 rpm is the V90 factory setting; use the p2000 of your drive."
    },
    {
      "name": "kv_torque_nm",
      "formula": "${kv}.torqueAct / 16384 * 1.0",
      "unit": "Nm",
      "decimals": 2,
      "type": "number",
      "description": "torqueAct scaled: 16#4000 = p2003 (reference torque). 1.00 Nm is the V90 factory setting; use the p2003 of your drive."
    },
    {
      "name": "kv_power_w",
      "formula": "calc.kv_torque_nm * calc.kv_speed_rpm * 2 * pi / 60",
      "unit": "W",
      "decimals": 0,
      "type": "number",
      "description": "Mechanical shaft power P = T * omega."
    },
    {
      "name": "kv_cable_fault",
      "formula": "changes(${kv}.bit06, 2) >= 6",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "bit06 changing 6 or more times within 2 s is faster than any real sensor: a loose cable or connector.",
      "event": {
        "severity": "warning",
        "text": "Sensor bit06 is flickering: loose cable?"
      }
    },
    {
      "name": "kv_crash",
      "formula": "abs(rate(calc.kv_speed_rpm, 0.3)) > 4000",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "The drive ramps at 1500 rpm/s. Speed changing faster than 4000 rpm/s means something stopped it: a collision.",
      "event": {
        "severity": "alarm",
        "text": "Speed changed faster than the drive can ramp: crash?"
      }
    },
    {
      "name": "kv_crash_seen",
      "formula": "stretch(calc.kv_crash, 10)",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "Keeps a crash visible for 10 s; kv_crash itself only lasts a fraction of a second."
    },
    {
      "name": "kv_cruising",
      "formula": "held(abs(calc.kv_speed_rpm) > 1000 && ${kv}.zsw1_enabled && !${kv}.zsw1_fault, 3)",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "Above 1000 rpm, enabled and without a fault, for 3 s without a break."
    },
    {
      "name": "kv_accel",
      "formula": "rate(calc.kv_speed_rpm, 0.5)",
      "unit": "rpm/s",
      "decimals": 0,
      "type": "number",
      "description": "How fast the speed is changing."
    }
  ],
  "editCode": ""
}