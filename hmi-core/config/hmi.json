  "calcs": [
    {
      "name": "kv_speed_rpm",
      "formula": "${pls}.reals_0",
      "unit": "rpm",
      "decimals": 0,
      "type": "number",
      "description": "Speed from TcpLink (txAnalog.reals[0], Hastighet [rpm]), already in rpm. The other kv_* calculations use this name, so they don't depend on where the PLC puts the speed."
    },
    {
      "name": "moment_Nm",
      "formula": "${pls}.ints_2 / 1000",
      "unit": "Nm",
      "decimals": 2,
      "type": "number",
      "description": "Torque from TcpLink (txAnalog.ints[2]). The PLC sends it in thousandths of a Nm, so it is divided by 1000 to Nm. kv_power_w uses this name."
    },
    {
      "name": "kv_power_w",
      "formula": "calc.moment_Nm * calc.kv_speed_rpm * 2 * pi / 60",
      "unit": "W",
      "decimals": 0,
      "type": "number",
      "description": "Mechanical shaft power P = T * omega."
    },
    {
      "name": "kv_cable_fault",
      "formula": "changes(${pls}.bit06, 2) >= 6",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "bit06 changing 6 or more times within 2 s is faster than any real sensor: a loose cable or connector.",
      "event": {
        "severity": "warning",
        "text": "Sensor bit06 is flickering: loose cable?"
      }
    },
    {
      "name": "kv_crash",
      "formula": "abs(rate(calc.kv_speed_rpm, 0.3)) > 4000",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "The drive ramps at 1500 rpm/s. Speed changing faster than 4000 rpm/s means something stopped it: a collision.",
      "event": {
        "severity": "alarm",
        "text": "Speed changed faster than the drive can ramp: crash?"
      }
    },
    {
      "name": "kv_crash_seen",
      "formula": "stretch(calc.kv_crash, 10)",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "Keeps a crash visible for 10 s; kv_crash itself only lasts a fraction of a second."
    },
    {
      "name": "kv_cruising",
      "formula": "held(abs(calc.kv_speed_rpm) > 1000 && ${pls}.zsw1_enabled && !${pls}.zsw1_fault, 3)",
      "unit": "",
      "decimals": 0,
      "type": "boolean",
      "description": "Above 1000 rpm, enabled and without a fault, for 3 s without a break."
    },
    {
      "name": "kv_accel",
      "formula": "rate(calc.kv_speed_rpm, 0.5)",
      "unit": "rpm/s",
      "decimals": 0,
      "type": "number",
      "description": "How fast the speed is changing."
    }
  ],
  "editCode": "4819"
}